      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const raw = $json.output;\nlet ai = {};\nif (raw && typeof raw === 'object') ai = raw;\nif (typeof raw === 'string') {\n  const trimmed = raw.trim();\n  const fence = String.fromCharCode(96, 96, 96);\n  let clean = trimmed;\n  if (clean.toLowerCase().startsWith(fence + 'json')) clean = clean.slice(7);\n  else if (clean.startsWith(fence)) clean = clean.slice(3);\n  if (clean.endsWith(fence)) clean = clean.slice(0, -3);\n  try { ai = JSON.parse(clean.trim()); } catch { ai = { customerFacingReply: trimmed }; }\n}\nconst redaction = $('Detect and Redact Secrets').item.json;\nconst bs = String.fromCharCode(92);\nlet intent = ai.intent || 'other';\nlet riskLevel = ai.riskLevel || 'medium';\nlet priority = ai.priority || 'normal';\nlet requiresHuman = Boolean(ai.requiresHuman);\nlet reply = ai.customerFacingReply || 'မေးမြန်းမှုအတွက် ကျေးဇူးတင်ပါသည်။ အသေးစိတ်စစ်ဆေးရန် support ticket တစ်ခု ဖန်တီးထားပါသည်။';\nlet recommendedAction = ai.recommendedAction || 'Review support ticket';\nlet summary = ai.summary || 'Customer support request';\nlet confidence = Number(ai.confidence ?? 0);\nlet policyApplied = 'ai_response_burmese_training_style_with_memory';\nconst hasMyanmar = (text) => /[က-႟]/.test(String(text || ''));\nif (redaction.containsSecret) {\n  policyApplied = 'secret_shared_template_burmese_training_style';\n  riskLevel = 'high'; priority = 'urgent'; requiresHuman = true;\n  if (!intent || intent === 'other') intent = redaction.secretTypes.includes('otp') ? 'login_problem' : 'account_specific';\n  reply = 'လုံခြုံရေးအတွက် OTP၊ PIN၊ စကားဝှက်၊ ကတ်နံပါတ်အပြည့်အစုံနှင့် လုံခြုံရေးကုဒ်များကို chat ထဲတွင် မမျှဝေရပါ။ ဤ chat မှ အဆိုပါအချက်အလက်များကို စစ်ဆေးအသုံးပြု၍ မရပါ။ တရားဝင် mobile banking app သို့မဟုတ် official customer support channel မှတစ်ဆင့် ဆက်သွယ်ရပါမည်။ လုံခြုံစွာဆက်လက်ကူညီရန် support ticket ဖန်တီးထားပါသည်။';\n  recommendedAction = 'Escalate to secure support. Customer shared: ' + (redaction.secretTypes || 'secret') + '.';\n  summary = 'Customer shared sensitive information (' + (redaction.secretTypes || 'secret') + ') and requires secure support follow-up.';\n}\nelse if (redaction.preAiRiskHint === 'urgent_sensitive' || ['fraud_report', 'card_issue'].includes(intent)) {\n  policyApplied = 'urgent_sensitive_template_burmese_training_style';\n  riskLevel = 'high'; priority = 'urgent'; requiresHuman = true;\n  reply = 'ဤကိစ္စသည် လုံခြုံရေးဆိုင်ရာ အရေးပေါ်ကူညီမှု လိုအပ်နိုင်ပါသည်။ တရားဝင် mobile banking app သို့မဟုတ် ဘဏ်၏ official support number မှတစ်ဆင့် ချက်ချင်းဆက်သွယ်ရပါမည်။ ဤ chat မှ account သို့မဟုတ် card အခြေအနေကို ပြောင်းလဲပေး၍ မရပါ။ ဆက်လက်ကူညီရန် support ticket ဖန်တီးထားပါသည်။';\n  recommendedAction = 'Escalate urgently to the relevant secure support team.';\n}\nelse if (!hasMyanmar(reply)) {\n  policyApplied = 'burmese_training_style_fallback';\n  reply = 'မေးမြန်းမှုအတွက် ကျေးဇူးတင်ပါသည်။ အသေးစိတ်စစ်ဆေးရန် support ticket တစ်ခု ဖန်တီးထားပါသည်။ လိုအပ်ပါက တရားဝင် customer support channel မှတစ်ဆင့် ဆက်သွယ်ပေးပါမည်။';\n}\nconst cardPattern = new RegExp(bs + 'b(?:' + bs + 'd[ -]?){13,19}' + bs + 'b', 'g');\nconst shortNumberPattern = new RegExp(bs + 'b' + bs + 'd{4,8}' + bs + 'b', 'g');\nreply = String(reply).replace(cardPattern, '[REDACTED]').replace(shortNumberPattern, (m) => redaction.containsSecret ? '[REDACTED]' : m);\nreturn { json: { ...redaction, aiOutput: ai, intent, riskLevel, priority, requiresHuman, recommendedAction, summary, reply, confidence, policyApplied, responseLanguage: 'my-MM' } };"
