    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const raw = $json.output;\nlet ai = {};\nif (raw && typeof raw === 'object') ai = raw;\nif (typeof raw === 'string') {\n  const trimmed = raw.trim();\n  const fence = String.fromCharCode(96, 96, 96);\n  let clean = trimmed;\n  if (clean.toLowerCase().startsWith(fence + 'json')) clean = clean.slice(7);\n  else if (clean.startsWith(fence)) clean = clean.slice(3);\n  if (clean.endsWith(fence)) clean = clean.slice(0, -3);\n  try { ai = JSON.parse(clean.trim()); } catch { ai = { customerFacingReply: trimmed }; }\n}\nconst redaction = $('Detect and Redact Secrets').item.json;\nconst bs = String.fromCharCode(92);\nconst lang = redaction.responseLanguage || 'my-MM';\nconst isMyanmar = lang === 'my-MM';\nlet intent = ai.intent || 'other';\nlet riskLevel = ai.riskLevel || 'medium';\nlet priority = ai.priority || 'normal';\nlet requiresHuman = Boolean(ai.requiresHuman);\nlet recommendedAction = ai.recommendedAction || 'Review support ticket';\nlet summary = ai.summary || 'Customer support request';\nlet confidence = Number(ai.confidence ?? 0);\nlet reply = ai.customerFacingReply || (isMyanmar ? 'မေးမြန်းမှုအတွက် ကျေးဇူးတင်ပါသည်။ အသေးစိတ်စစ်ဆေးရန် support ticket တစ်ခု ဖန်တီးထားပါသည်။' : 'Thank you for your question. A support ticket has been created for review.');\nlet policyApplied = isMyanmar ? 'ai_response_burmese_training_style_with_memory' : 'ai_response_english_training_style_with_memory';\nconst hasMyanmar = (text) => /[က-႟]/.test(String(text || ''));\nconst hasLatin = (text) => /[A-Za-z]/.test(String(text || ''));\nif (redaction.containsSecret) {\n  policyApplied = isMyanmar ? 'secret_shared_template_burmese_training_style' : 'secret_shared_template_english_training_style';\n  riskLevel = 'high';\n  priority = 'urgent';\n  requiresHuman = true;\n  if (!intent || intent === 'other') intent = String(redaction.secretTypes || '').includes('otp') ? 'login_problem' : 'account_specific';\n  reply = isMyanmar\n    ? 'လုံခြုံရေးအတွက် OTP၊ PIN၊ စကားဝှက်၊ ကတ်နံပါတ်အပြည့်အစုံနှင့် လုံခြုံရေးကုဒ်များကို chat ထဲတွင် မမျှဝေရပါ။ ဤ chat မှ အဆိုပါအချက်အလက်များကို စစ်ဆေးအသုံးပြု၍ မရပါ။ တရားဝင် mobile banking app သို့မဟုတ် official customer support channel မှတစ်ဆင့် ဆက်သွယ်ရပါမည်။ လုံခြုံစွာဆက်လက်ကူညီရန် support ticket ဖန်တီးထားပါသည်။'\n    : 'For security, do not share OTPs, PINs, passwords, full card numbers, or security codes in chat. These details cannot be processed here. Please use the official banking app or official customer support channel; a support ticket has been created for secure follow-up.';\n  recommendedAction = 'Escalate to secure support. Customer shared: ' + (redaction.secretTypes || 'secret') + '.';\n  summary = 'Customer shared sensitive information (' + (redaction.secretTypes || 'secret') + ') and requires secure support follow-up.';\n}\nelse if (redaction.preAiRiskHint === 'urgent_sensitive' || ['fraud_report', 'card_issue'].includes(intent)) {\n  policyApplied = isMyanmar ? 'urgent_sensitive_template_burmese_training_style' : 'urgent_sensitive_template_english_training_style';\n  riskLevel = 'high';\n  priority = 'urgent';\n  requiresHuman = true;\n  reply = isMyanmar\n    ? 'ဤကိစ္စသည် လုံခြုံရေးဆိုင်ရာ အရေးပေါ်ကူညီမှု လိုအပ်နိုင်ပါသည်။ တရားဝင် mobile banking app သို့မဟုတ် ဘဏ်၏ official support number မှတစ်ဆင့် ချက်ချင်းဆက်သွယ်ရပါမည်။ ဤ chat မှ account သို့မဟုတ် card အခြေအနေကို ပြောင်းလဲပေး၍ မရပါ။ ဆက်လက်ကူညီရန် support ticket ဖန်တီးထားပါသည်။'\n    : 'This may require urgent security support. Please contact the bank through the official mobile banking app or official support number immediately. This chat cannot change account or card status; a support ticket has been created for follow-up.';\n  recommendedAction = 'Escalate urgently to the relevant secure support team.';\n}\nelse if (isMyanmar && !hasMyanmar(reply)) {\n  policyApplied = 'burmese_training_style_fallback';\n  reply = 'မေးမြန်းမှုအတွက် ကျေးဇူးတင်ပါသည်။ အသေးစိတ်စစ်ဆေးရန် support ticket တစ်ခု ဖန်တီးထားပါသည်။ လိုအပ်ပါက တရားဝင် customer support channel မှတစ်ဆင့် ဆက်သွယ်ပေးပါမည်။';\n}\nelse if (!isMyanmar && hasMyanmar(reply) && !hasLatin(reply)) {\n  policyApplied = 'english_training_style_fallback';\n  reply = 'Thank you for your question. A support ticket has been created for review. If needed, support will follow up through an official customer support channel.';\n}\nconst cardPattern = new RegExp(bs + 'b(?:' + bs + 'd[ -]?){13,19}' + bs + 'b', 'g');\nconst shortNumberPattern = new RegExp(bs + 'b' + bs + 'd{4,8}' + bs + 'b', 'g');\nreply = String(reply).replace(cardPattern, '[REDACTED]').replace(shortNumberPattern, (m) => redaction.containsSecret ? '[REDACTED]' : m);\nreturn { json: { ...redaction, aiOutput: ai, intent, riskLevel, priority, requiresHuman, recommendedAction, summary, reply, confidence, policyApplied, responseLanguage: lang } };"
