      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const data = $json;\nconst original = String(data.message || '');\nlet sanitized = original;\nconst findings = new Set();\nconst bs = String.fromCharCode(92);\nconst word = bs + 'b';\nconst sp = bs + 's';\nconst mmZero = String.fromCharCode(0x1040);\nconst mmNine = String.fromCharCode(0x1049);\nconst digit = '[0-9' + mmZero + '-' + mmNine + ']';\nconst digits = digit + '{4,8}';\nconst nonDigit40 = '[^0-9' + mmZero + '-' + mmNine + bs + 'r' + bs + 'n]{0,40}';\nconst nonDigit30 = '[^0-9' + mmZero + '-' + mmNine + bs + 'r' + bs + 'n]{0,30}';\nfunction redact(type, pattern, replacement) {\n  if (pattern.test(sanitized)) {\n    findings.add(type);\n    sanitized = sanitized.replace(pattern, replacement);\n  }\n}\nconst myanmarChars = (original.match(/[က-႟]/g) || []).length;\nconst latinChars = (original.match(/[A-Za-z]/g) || []).length;\nconst responseLanguage = myanmarChars > 0 && myanmarChars >= Math.max(1, latinChars / 2) ? 'my-MM' : 'en-US';\nconst responseLanguageName = responseLanguage === 'my-MM' ? 'Myanmar Burmese, Unicode, my-MM' : 'English, en-US';\nredact('otp', new RegExp(word + '(otp|one[-' + sp + ']?time password|verification code|အိုတီပီ|OTP)' + word + nonDigit40 + digits, 'giu'), '$1 [REDACTED_OTP]');\nredact('otp', new RegExp('(ကုဒ်|အတည်ပြုကုဒ်|လုံခြုံရေးကုဒ်)' + nonDigit40 + digits, 'giu'), '$1 [REDACTED_OTP]');\nredact('pin', new RegExp(word + '(pin|PIN|ပင်)' + word + nonDigit30 + digits, 'giu'), '$1 [REDACTED_PIN]');\nredact('password', new RegExp(word + '(password|passcode|စကားဝှက်)' + word + sp + '*(is|:|=|က|မှာ|သည်)?' + sp + '*[^' + sp + ',.;]+', 'giu'), '$1 [REDACTED_PASSWORD]');\nredact('security_code', new RegExp(word + '(cvv|cvc|security code|card security code|လုံခြုံရေးကုဒ်)' + word + nonDigit30 + digit + '{3,4}', 'giu'), '$1 [REDACTED_SECURITY_CODE]');\nredact('full_card_number', new RegExp(word + '(?:' + bs + 'd[ -]?){13,19}' + word, 'g'), '[REDACTED_POSSIBLE_CARD_OR_ACCOUNT_NUMBER]');\nredact('account_number', new RegExp(word + '(account|acct|အကောင့်)' + sp + '*(number|no|#|နံပါတ်)?' + sp + '*(is|:|=|က|မှာ|သည်)?' + sp + '*' + bs + 'd{6,18}', 'giu'), '$1 number [REDACTED_ACCOUNT_NUMBER]');\nconst secretTypes = Array.from(findings);\nconst containsSecret = secretTypes.length > 0;\nlet preAiRiskHint = 'none';\nif (containsSecret) preAiRiskHint = 'secret_shared';\nelse if (/fraud|unauthorized|stolen|lost card|lost debit|lost credit|scam|phishing|လိမ်|မသိဘဲ|ပျောက်|ကတ်ပျောက်/iu.test(original)) preAiRiskHint = 'urgent_sensitive';\nreturn { json: { ...data, originalMessage: original, sanitizedMessage: sanitized, containsSecret, secretTypes: secretTypes.join(','), preAiRiskHint, responseLanguage, responseLanguageName } };"
      },
