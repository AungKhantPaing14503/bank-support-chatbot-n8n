    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const raw = $json.output;\nlet ai = {};\nif (raw && typeof raw === 'object') ai = raw;\nif (typeof raw === 'string') {\n  const trimmed = raw.trim();\n  const fence = String.fromCharCode(96, 96, 96);\n  let clean = trimmed;\n  if (clean.toLowerCase().startsWith(fence + 'json')) clean = clean.slice(7);\n  else if (clean.startsWith(fence)) clean = clean.slice(3);\n  if (clean.endsWith(fence)) clean = clean.slice(0, -3);\n  try { ai = JSON.parse(clean.trim()); } catch { ai = { customerFacingReply: trimmed }; }\n}\nconst redaction = $('Detect and Redact Secrets').item.json;\nconst bs = String.fromCharCode(92);\nconst nl = String.fromCharCode(10);\nconst lines = (...parts) => parts.join(nl);\nconst normalizeReply = (value) => {\n  let text = String(value || '').split(bs + 'n').join(nl).split('**').join('');\n  text = text.split(nl).map((line) => {\n    const trimmed = line.trimStart();\n    const prefix = line.slice(0, line.length - trimmed.length);\n    return trimmed.startsWith('* ') ? prefix + '- ' + trimmed.slice(2) : line;\n  }).join(nl);\n  while (text.includes(nl + nl + nl)) text = text.split(nl + nl + nl).join(nl + nl);\n  return text.trim();\n};\nconst lang = redaction.responseLanguage || 'my-MM';\nconst isMyanmar = lang === 'my-MM';\nconst honestFallback = isMyanmar\n  ? lines('တောင်းပန်ပါတယ်။ ဒီမေးခွန်းအတွက် အတိအကျဖြေဆိုနိုင်တဲ့ အချက်အလက် မရှိသေးပါဘူး။', '', 'လုံခြုံပြီး မှန်ကန်တဲ့အချက်အလက်ရရန် official bank website၊ mobile banking app သို့မဟုတ် official support channel မှတစ်ဆင့် စစ်ဆေးပေးပါနော်။')\n  : lines('I’m sorry, I don’t have the exact information needed to answer that confidently.', '', 'For the most accurate help, please check the official bank website, mobile banking app, or contact an official support channel.');\nlet intent = ai.intent || 'other';\nlet riskLevel = ai.riskLevel || 'medium';\nlet priority = ai.priority || 'normal';\nlet requiresHuman = Boolean(ai.requiresHuman);\nlet recommendedAction = ai.recommendedAction || 'Review support ticket';\nlet summary = ai.summary || 'Customer support request';\nlet confidence = Number(ai.confidence ?? 0);\nlet reply = ai.customerFacingReply || honestFallback;\nlet policyApplied = isMyanmar ? 'ai_response_burmese_readable_with_memory' : 'ai_response_english_readable_with_memory';\nconst hasMyanmar = (text) => /[က-႟]/.test(String(text || ''));\nconst hasLatin = (text) => /[A-Za-z]/.test(String(text || ''));\nif (redaction.containsSecret) {\n  policyApplied = isMyanmar ? 'secret_shared_readable_burmese' : 'secret_shared_readable_english';\n  riskLevel = 'high'; priority = 'urgent'; requiresHuman = true;\n  reply = isMyanmar ? lines('လုံခြုံရေးအတွက် chat ထဲမှာ အရေးကြီးအချက်အလက်တွေ မမျှဝေပါနဲ့နော်။', '', 'မမျှဝေရမည့်အချက်များ -', '- OTP', '- PIN သို့မဟုတ် စကားဝှက်', '- ကတ်နံပါတ်အပြည့်အစုံ', '- CVV သို့မဟုတ် လုံခြုံရေးကုဒ်', '', 'တရားဝင် mobile banking app သို့မဟုတ် official customer support channel မှတစ်ဆင့် ဆက်သွယ်ပါနော်။') : lines('For your security, please do not share sensitive details in chat.', '', 'Please avoid sharing:', '- OTPs', '- PINs or passwords', '- Full card numbers', '- CVV or security codes', '', 'Please use the official banking app or official customer support channel.');\n  recommendedAction = 'Escalate to secure support. Customer shared: ' + (redaction.secretTypes || 'secret') + '.';\n  summary = 'Customer shared sensitive information and requires secure support follow-up.';\n}\nelse if (redaction.preAiRiskHint === 'urgent_sensitive' || ['fraud_report', 'card_issue'].includes(intent)) {\n  policyApplied = isMyanmar ? 'urgent_sensitive_readable_burmese' : 'urgent_sensitive_readable_english';\n  riskLevel = 'high'; priority = 'urgent'; requiresHuman = true;\n  reply = isMyanmar ? lines('ဤကိစ္စသည် လုံခြုံရေးဆိုင်ရာ အရေးပေါ်ကူညီမှု လိုအပ်နိုင်ပါသည်။', '', 'ကျေးဇူးပြု၍ အောက်ပါ official channel များမှတစ်ဆင့် ချက်ချင်းဆက်သွယ်ပါနော် -', '- တရားဝင် mobile banking app', '- ဘဏ်၏ official support number', '', 'ဤ chat မှ account သို့မဟုတ် card အခြေအနေကို ပြောင်းလဲပေး၍ မရပါ။') : lines('This may require urgent security support.', '', 'Please contact the bank immediately through an official channel:', '- Official mobile banking app', '- Official support number', '', 'This chat cannot change account or card status.');\n  recommendedAction = 'Escalate urgently to the relevant secure support team.';\n}\nelse if (redaction.preAiRiskHint === 'live_or_exact_info') {\n  policyApplied = isMyanmar ? 'exact_info_honest_burmese' : 'exact_info_honest_english';\n  reply = isMyanmar ? lines('အတိအကျနှင့် နောက်ဆုံးပေါ် အချက်အလက်ကို ဒီ chat ထဲမှာ အတည်ပြုပေးနိုင်ခြင်း မရှိသေးပါဘူး။', '', 'ဥပမာ - rate၊ fee၊ branch hour၊ product term စတဲ့အချက်တွေက ပြောင်းလဲနိုင်ပါတယ်။', '', 'အမှန်ဆုံးအချက်အလက်အတွက် official bank website၊ mobile banking app သို့မဟုတ် official support channel မှတစ်ဆင့် စစ်ဆေးပေးပါနော်။') : lines('I don’t have access to the exact current details for that in this chat.', '', 'Rates, fees, branch hours, and product terms can change.', '', 'For the most accurate answer, please check the official bank website, mobile banking app, or contact official support.');\n}\nelse if (isMyanmar && !hasMyanmar(reply)) {\n  policyApplied = 'burmese_readable_fallback'; reply = honestFallback;\n}\nelse if (!isMyanmar && hasMyanmar(reply) && !hasLatin(reply)) {\n  policyApplied = 'english_readable_fallback'; reply = honestFallback;\n}\nconst cardPattern = new RegExp(bs + 'b(?:' + bs + 'd[ -]?){13,19}' + bs + 'b', 'g');\nconst shortNumberPattern = new RegExp(bs + 'b' + bs + 'd{4,8}' + bs + 'b', 'g');\nreply = normalizeReply(reply).replace(cardPattern, '[REDACTED]').replace(shortNumberPattern, (m) => redaction.containsSecret ? '[REDACTED]' : m);\nif (!reply || reply.length < 2) reply = honestFallback;\nreturn { json: { ...redaction, aiOutput: ai, intent, riskLevel, priority, requiresHuman, recommendedAction, summary, reply, confidence, policyApplied, responseLanguage: lang } };"
